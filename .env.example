NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FLOCI_ENDPOINT=http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
CACHE_TTL_MS=60000
CACHE_URL=redis://localhost:6379
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_CONNECT_RETRIES=5
CACHE_CLUSTER_ID=school-bus-tracker-cache
CACHE_ENGINE_VERSION=7.1
CACHE_NODE_TYPE=cache.t3.micro
API_GATEWAY_ID=
API_GATEWAY_STAGE=local
API_GATEWAY_NAME=school-bus-tracker-api
API_GATEWAY_INVOKE_ENDPOINT=http://localhost:4566
API_BACKEND_URL=http://backend:3000
SQS_QUEUE_NAME=bus-tracker-notifications-queue
# Optional: leave blank to discover the local Floci queue URL.
SQS_QUEUE_URL=
CLOUDWATCH_LOG_GROUP=/school-bus-tracker/backend
CLOUDWATCH_LOG_STREAM=audit
ENABLE_NOTIFICATION_WORKER=true
SEED_SAMPLE_DATA=false
# Local-only sample account credentials (at least 8 characters, at most 72 bytes).
SEED_ADMIN_NAME=Demo Administrator
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_SUPERVISOR_NAME=Demo Supervisor
SEED_SUPERVISOR_EMAIL=supervisor@example.test
SEED_SUPERVISOR_PASSWORD=
SEED_PARENT_NAME=Demo Parent
SEED_PARENT_EMAIL=parent@example.test
SEED_PARENT_PASSWORD=
