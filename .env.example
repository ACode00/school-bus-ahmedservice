# Schedule & Arrival service (plus signup and login), Team 14.
# Copy this file to .env and change what you need. Every value here is a
# placeholder or a safe local default. Never commit the real .env.
# Required = the app does not start or a script fails without it.

# --- App ---
# Required. development locally, production inside ECS.
NODE_ENV=development
# Required. Port the Express API listens on.
PORT=3000
# Required. Browser origins allowed by CORS (the React frontend runs on 5173).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Floci (local AWS emulator) ---
# Required. Floci endpoint. Both names are read.
FLOCI_ENDPOINT=http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566
# Required. Region used for every AWS client.
AWS_REGION=us-east-1
# Required for Floci. Floci accepts these dummy keys. Never put real AWS keys here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Optional. Floci account id (default 000000000000).
FLOCI_ACCOUNT_ID=000000000000

# --- ElastiCache (Redis) ---
# Optional. How long ETA answers stay cached, in ms.
CACHE_TTL_MS=60000
# Required. Redis address. CACHE_URL wins over CACHE_HOST and CACHE_PORT.
CACHE_URL=redis://localhost:6379
CACHE_HOST=localhost
CACHE_PORT=6379
# Optional. Reconnect tries before the app gives up on Redis.
CACHE_CONNECT_RETRIES=5
# Optional. ElastiCache cluster settings used by the provisioner.
CACHE_CLUSTER_ID=school-bus-tracker-cache
CACHE_ENGINE_VERSION=7.1
CACHE_NODE_TYPE=cache.t3.micro
# Optional. How often and how long the provisioner waits for the cache cluster.
CACHE_POLL_ATTEMPTS=60
CACHE_POLL_DELAY_MS=1000

# --- API Gateway ---
# Optional. Leave API_GATEWAY_ID empty: the provisioner creates the API and prints its id.
API_GATEWAY_ID=
API_GATEWAY_STAGE=local
API_GATEWAY_NAME=school-bus-tracker-api
API_GATEWAY_INVOKE_ENDPOINT=http://localhost:4566
# Required. Where API Gateway forwards requests (the backend container).
API_BACKEND_URL=http://backend:3000

# --- ECS (containers) ---
# Optional. Names used by the ECS provisioner. The defaults work on Floci.
BUS_TRACKER_IMAGE=school-bus-tracker-backend:local
ECR_REPOSITORY=school-bus-tracker-backend
ECS_CLUSTER_NAME=school-bus-tracker
ECS_SERVICE_NAME=school-bus-tracker-api
ECS_TASK_FAMILY=school-bus-tracker-api
ECS_WORKER_SERVICE_NAME=school-bus-tracker-worker
ECS_WORKER_TASK_FAMILY=school-bus-tracker-api-worker
# Optional. How many API copies ECS runs.
ECS_DESIRED_COUNT=1

# --- SQS (notifications) ---
SQS_QUEUE_NAME=bus-tracker-notifications-queue
# Optional: leave blank to discover the local Floci queue URL.
SQS_QUEUE_URL=
# Optional. true runs the worker that reads the queue.
ENABLE_NOTIFICATION_WORKER=true

# --- CloudWatch ---
# Optional. Log group and stream for app and audit logs. The SECURITY metric
# filter and the two alarms are created on this log group.
CLOUDWATCH_LOG_GROUP=/school-bus-tracker/backend
CLOUDWATCH_LOG_STREAM=audit

# --- IAM Identity Center (optional, not used by email login) ---
# Only needed for the old Identity Center provisioner. Leave empty.
SSO_INSTANCE_ARN=
SSO_IDENTITY_STORE_ID=
SSO_REGION=us-east-1
SSO_ACCOUNT_ID=000000000000

# --- Sample data (local only) ---
# true creates demo routes and one admin, one supervisor and one parent account.
SEED_SAMPLE_DATA=false
# Set a strong password for each account (8 to 72 characters). Never commit them.
SEED_ADMIN_NAME=Demo Administrator
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_SUPERVISOR_NAME=Demo Supervisor
SEED_SUPERVISOR_EMAIL=supervisor@example.test
SEED_SUPERVISOR_PASSWORD=
SEED_PARENT_NAME=Demo Parent
SEED_PARENT_EMAIL=parent@example.test
SEED_PARENT_PASSWORD=
